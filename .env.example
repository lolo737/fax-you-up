# Fax You Up! — environment variables.
# Copy to .env for `netlify dev`, and set the same names in
# Netlify → Site configuration → Environment variables for production.
# Never commit real values. Use Stripe/Telnyx TEST credentials while developing.

# Public base URL of the site (no trailing slash). Netlify also provides URL.
SITE_URL=http://localhost:8888

# Long random string: signs session cookies, sign-in links and media URLs.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Optional separate secret for the signed PDF URLs Telnyx fetches (falls back to SESSION_SECRET).
MEDIA_URL_SECRET=

# --- Stripe (https://dashboard.stripe.com/test/apikeys) ---
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` locally, or the webhook endpoint's signing secret in the Dashboard.
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Telnyx Programmable Fax (https://portal.telnyx.com) ---
TELNYX_API_KEY=KEY...
# The Fax Application ID (connection_id) your from-number is assigned to.
TELNYX_CONNECTION_ID=
# Your Telnyx number in E.164, e.g. +4930...
TELNYX_FROM_NUMBER=+
# Portal → Keys & Credentials → Public Key (base64). Used to verify webhook signatures.
TELNYX_PUBLIC_KEY=
# Local experiments only: skip Telnyx signature checks. Ignored when CONTEXT=production.
TELNYX_SKIP_SIGNATURE_VERIFICATION=false

# --- E-mail: resend | postmark | console (logs instead of sending) ---
EMAIL_PROVIDER=console
EMAIL_FROM=Fax You Up! <faxes@example.com>
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=

# --- Storage: netlify-blobs (default) | memory (lost on restart; tests/demos only) ---
STORAGE_DRIVER=netlify-blobs
# Only needed when running outside Netlify's runtime:
NETLIFY_SITE_ID=
NETLIFY_BLOBS_TOKEN=

# --- Admin (/ops-room.html) ---
# npm run hash-password -- "a long passphrase"
ADMIN_PASSWORD_HASH=
# npm run totp-setup
ADMIN_TOTP_SECRET=
